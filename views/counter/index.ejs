<!-- ==========================================================================
 * FILE: views/counter/index.ejs
 * DESCRIPTION: หน้าหลักระบบพนักงานเคาน์เตอร์สำหรับแสดงรายการออเดอร์ที่พร้อมเสิร์ฟ
 *              รองรับการกรองสถานะ, ค้นหา, ดูรายละเอียดออเดอร์ และอัปเดตข้อมูลเรียลไทม์
 * ========================================================================== -->

<!-- ==========================================
 * SECTION 1: PARTIAL INCLUDES & HEAD SETUP
 * ========================================== -->
<%- include('../partials/head', {css: 'counter', title: 'ออเดอร์ที่พร้อมเสิร์ฟ', refresh: 0 }) %>

<body>
<div class="staff">
  <!-- แถบส่วนหัวระบบสำหรับพนักงานหน้าเคาน์เตอร์ -->
  <%- include('../partials/staff-top', { roleLabel: 'หน้าเคาน์เตอร์' }) %>

  <main class="s-main">
    <!-- ==========================================
     * SECTION 2: PAGE TITLE & ALERT MESSAGES
     * ========================================== -->
    <h1 class="s-title">แสดงออเดอร์ที่พร้อมเสิร์ฟ</h1>

    <!-- แถบแสดงข้อความแจ้งเตือนเมื่ออัปเดตสถานะออเดอร์สำเร็จ -->
    <% if (typeof success !== 'undefined' && success) { %>
      <div class="alert alert-green" role="status" style="margin-bottom: 20px;">
        ✔ ออเดอร์ #<%= success %> พร้อมเสิร์ฟ ส่งแจ้งเตือนไปที่หน้าจอลูกค้าแล้ว
      </div>
    <% } %>

    <!-- ==========================================
     * SECTION 3: TOOLBAR (STATUS TABS & SEARCH FORM)
     * ========================================== -->
    <div class="counter-toolbar">
      <!-- แท็บตัวกรองสถานะออเดอร์ (กำลังเตรียม / ปรุงเสร็จสิ้น / เสร็จสิ้นวันนี้) -->
      <div class="counter-tabs">
        <a href="?tab=preparing&q=<%= q %>" class="counter-tab preparing-tab <%= tab === 'preparing' ? 'active' : '' %>">
          📋 กำลังเตรียม <b><%= (counts && counts.preparing) || 0 %></b> <span>ออเดอร์</span>
        </a>
        <a href="?tab=cooked&q=<%= q %>" class="counter-tab cooked-tab <%= tab === 'cooked' ? 'active' : '' %>">
          🍲 ปรุงเสร็จสิ้น <b><%= (counts && counts.cooked) || 0 %></b> <span>ออเดอร์</span>
        </a>
        <a href="?tab=done&q=<%= q %>" class="counter-tab done-tab <%= tab === 'done' ? 'active' : '' %>">
          ✅ เสร็จสิ้นวันนี้ <b><%= (counts && counts.done) || 0 %></b> <span>ออเดอร์</span>
        </a>
      </div>

      <!-- ช่องค้นหาหมายเลขออเดอร์ -->
      <form class="counter-search" method="get">
        <input type="hidden" name="tab" value="<%= tab %>">
        <input type="search" name="q" value="<%= q %>" placeholder="🔍 ค้นหาเลขออเดอร์" aria-label="ค้นหาเลขออเดอร์">
      </form>
    </div>

    <!-- ==========================================
     * SECTION 4: ORDER CARDS GRID & EMPTY STATE
     * ========================================== -->
    <div class="s-layout <%= selected ? 'has-side' : '' %>">

      <!-- ตารางการ์ดรายการออเดอร์ -->
      <section class="order-grid">
        <% if (!list || list.length === 0) { %>
          <!-- แสดงเมื่อไม่พบออเดอร์ในหมวดหมู่ที่เลือก -->
          <div class="empty-order">
            <div class="empty-icon">🍽️</div>
            <p>ไม่พบออเดอร์ในหมวดหมู่นี้</p>
          </div>
        <% } else { %>
          <% list.forEach(function (o) { %>
            <div class="o-card <%= selected && selected.Order_ID === o.Order_ID ? 'selected' : '' %>">
              
              <!-- ส่วนหัวการ์ด (หมายเลขออเดอร์, หมายเลขโต๊ะ, เวลา) -->
              <div class="o-card-head">
                <div>
                  <span class="o-no"><%= orderNo(o.Reference_Code) %></span>
                  <!-- แสดงข้อความ กลับบ้าน หรือ โต๊ะ บนการ์ด -->
                  <span class="o-table"><%= (!o.Table_Number || o.Order_type === 'กลับบ้าน') ? 'กลับบ้าน' : 'โต๊ะ ' + o.Table_Number %></span>
                </div>
                <span class="o-time"><%= o.Order_Time %> น.</span>
              </div>

              <!-- รายละเอียดออเดอร์ (รูปภาพ/ไอคอนซ้าย - ลิสต์รายการขวา) -->
              <div class="o-content">
                <div class="o-content-left">
                  <% if (o.items && o.items[0] && o.items[0].Image_URL) { %>
                    <img src="<%= o.items[0].Image_URL %>" alt="Order Image">
                  <% } else { %>
                    🍜
                  <% } %>
                </div>

                <div class="o-content-right">
                  <% if (o.items && o.items.length > 0) { %>
                    <% o.items.forEach(function (it) { %>
                      <div class="o-list-item">
                        <div class="o-list-item-info">
                          <div class="o-list-item-header">
                            <span class="o-list-item-name">• <%= it.Menu_Name %></span>
                            <% if (it.Spiciness_Level) { %>
                              <span class="spice-badge">🌶 <%= it.Spiciness_Level %></span>
                            <% } %>
                          </div>
                          <% if (it.Special_Note) { %>
                            <div class="note-badge">📝 <%= it.Special_Note %></div>
                          <% } %>
                        </div>
                        <div class="o-list-item-qty">x<%= it.Quantity %></div>
                      </div>
                    <% }) %>
                  <% } else { %>
                    <div style="color: #999; font-size: 12px;">ไม่มีรายการอาหาร</div>
                  <% } %>
                </div>
              </div>

              <!-- ปุ่มอัปเดตสถานะและดูรายละเอียด -->
              <div class="o-actions">
                <span class="order-status status-<%= o.Status || 'cooked' %>">
                  <% if (o.Status === 'preparing' || tab === 'preparing') { %>
                    กำลังเตรียม
                  <% } else if (o.Status === 'cooked' || tab === 'cooked') { %>
                    ปรุงเสร็จสิ้น
                  <% } else if (o.Status === 'ready') { %>
                    พร้อมเสิร์ฟ
                  <% } else if (o.Status === 'done' || tab === 'done') { %>
                    เสร็จสิ้น
                  <% } else { %>
                    อัปเดตสถานะ
                  <% } %>
                </span>
                <a class="detail-btn" href="?tab=<%= tab %>&q=<%= q %>&id=<%= o.Order_ID %>">ดูรายละเอียด</a>
              </div>
            </div>
          <% }) %>
        <% } %>
      </section>

      <!-- ==========================================
       * SECTION 5: SELECTED ORDER DETAIL PANEL
       * ========================================== -->
      <!-- พาเนลแสดงรายละเอียดออเดอร์ที่ถูกเลือกทางด้านขวา -->
      <% if (selected) { %>
        <aside class="panel counter-detail-panel">
          <div class="detail-head">
            <div class="detail-head-row1">
              <!-- แสดงข้อความ กลับบ้าน หรือ โต๊ะ บนพาเนลรายละเอียด -->
              <div class="detail-title-text">รายละเอียดออเดอร์ · <%= (!selected.Table_Number || selected.Order_type === 'กลับบ้าน') ? 'กลับบ้าน' : 'โต๊ะ ' + selected.Table_Number %></div>
              <a class="close-x" href="?tab=<%= tab %>&q=<%= q %>" aria-label="ปิด">✕</a>
            </div>
            <div class="detail-head-row2">
              <span class="detail-order-no"><%= orderNo(selected.Reference_Code) %></span>
              <div class="detail-time-text">
                <div>🕒 <%= selected.Order_Time %> น.</div>
                <div><%= selected.Order_Date || '' %></div>
              </div>
            </div>
          </div>

          <!-- ตารางแสดงรายการอาหารทั้งหมด -->
          <%- include('../partials/items-table', { order: selected }) %>

          <% if (tab === 'cooked') { %>
            <div class="detail-actions">
              <a class="detail-update-btn" href="/counter/status?id=<%= selected.Order_ID %>">
                อัปเดตสถานะ
              </a>
            </div>
          <% } %>
        </aside>
      <% } %>
    </div>
  </main>

  <!-- ==========================================
   * SECTION 6: BOTTOM NAV & REAL-TIME POLLING
   * ========================================== -->
  <!-- แถบเมนูนำทางด้านล่างสำหรับพนักงานเคาน์เตอร์ -->
  <%- include('../partials/counter-nav') %>
</div>

<!-- สคริปต์อัปเดตข้อมูลแบบเรียลไทม์อัตโนมัติ -->
<script>
  (function() {
    setInterval(function() {
      fetch(window.location.href)
        .then(res => res.text())
        .then(html => {
          const doc = new DOMParser().parseFromString(html, 'text/html');
          
          // 1. ตรวจสอบว่าออเดอร์ที่ถูกเลือกไว้หายไปหรือไม่ (เช่น ถูกอัปเดตสถานะสำเร็จไปแล้ว)
          const currentDetail = document.querySelector('.counter-detail-panel');
          const newDetail = doc.querySelector('.counter-detail-panel');
          if (currentDetail && !newDetail) {
            window.location.reload();
            return;
          }

          // 2. อัปเดตแท็บตัวกรองด้านบน (ตัวเลขจำนวนออเดอร์แต่ละหมวด)
          const newTabs = doc.querySelector('.counter-tabs');
          if (newTabs) {
            document.querySelector('.counter-tabs').innerHTML = newTabs.innerHTML;
          }
          
          // 3. อัปเดตรายการการ์ดออเดอร์ทั้งหมด พร้อมรักษาระดับการเลื่อนเมาส์ (Scroll) ไว้
          const currentGrid = document.querySelector('.order-grid');
          const newGrid = doc.querySelector('.order-grid');
          if (currentGrid && newGrid) {
            const scrollTop = currentGrid.scrollTop;
            currentGrid.innerHTML = newGrid.innerHTML;
            currentGrid.scrollTop = scrollTop;
          }
        })
        .catch(err => console.error('Real-time update error:', err));
    }, 1000);
  })();
</script>

</body>
</html>
<!-- ==========================================================================
 * FILE: views/index.ejs
 * DESCRIPTION: หน้าหลักศูนย์กลางของระบบ แสดงเมนูเลือกเข้าใช้งานระบบย่อยสำหรับพนักงานแต่ละตำแหน่ง
 * ========================================================================== -->

<!-- ==========================================
 * SECTION 1: PARTIAL INCLUDES & HEAD SETUP
 * ========================================== -->
<%- include('partials/head', { title: 'หน้าแรก' }) %>

<body>
<!-- คอนเทนเนอร์หลักสำหรับจัดวางเค้าโครงหน้าแรก -->
<main class="home">

  <!-- ==========================================
   * SECTION 2: HERO BANNER & WELCOME HEADER
   * ========================================== -->
  <!-- ส่วนแสดงแบนเนอร์ยินดีต้อนรับและชื่อระบบ -->
  <section class="home-hero">
    <div class="bowl">🍲</div>
    <div>
      <h1>หม่าล่า Self Service</h1>
      <p class="muted">เลือกหน้าจอที่ต้องการเปิดใช้งาน</p>
    </div>
  </section>

  <!-- ==========================================
   * SECTION 3: ROLE NAVIGATION CARDS
   * ========================================== -->
  <!-- เมนูเลือกเข้าสู่ระบบย่อยตามบทบาทหน้าที่ของพนักงาน -->
  <section class="home-grid">
    <!-- ลิงก์ไปหน้าสร้างและจัดการ QR Code ประจำโต๊ะ -->
    <a class="home-card" href="/qr">
      <span class="ico">🔳</span>
      <h3>QR Code ประจำโต๊ะ</h3>
      <p>สแกนเพื่อเข้าสู่ระบบสั่งอาหาร</p>
    </a>

    <!-- ลิงก์ไปหน้าระบบแคชเชียร์สำหรับรับชำระเงินสด -->
    <a class="home-card" href="/cashier">
      <span class="ico">💵</span>
      <h3>พนักงานแคชเชียร์</h3>
      <p>รับชำระเงินสด</p>
    </a>

    <!-- ลิงก์ไปหน้าระบบพนักงานครัวสำหรับจัดการรายการปรุงอาหาร -->
    <a class="home-card" href="/kitchen">
      <span class="ico">👨‍🍳</span>
      <h3>พนักงานครัว</h3>
      <p>ออเดอร์ที่ต้องปรุง</p>
    </a>

    <!-- ลิงก์ไปหน้าระบบเคาน์เตอร์สำหรับเปลี่ยนสถานะเสิร์ฟและเรียกรับอาหาร -->
    <a class="home-card" href="/counter">
      <span class="ico">🛎️</span>
      <h3>พนักงานหน้าเคาน์เตอร์</h3>
      <p>ส่งมอบอาหาร และแจ้งเตือนลูกค้า</p>
    </a>
  </section>

</main>
</body>
</html>
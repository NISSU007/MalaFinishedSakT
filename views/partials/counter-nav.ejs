<!-- ==========================================================================
 * FILE: views/partials/counter_bottom_nav.ejs
 * DESCRIPTION: แถบเมนูนำทางด้านล่างของพนักงานหน้าเคาน์เตอร์
 *              สำหรับสลับระหว่างหน้า "ออเดอร์ที่ต้องเสิร์ฟ" และ "แจ้งเตือนลูกค้า"
 * ========================================================================== -->

<nav class="s-bottom-nav">

  <!-- ==========================================
   * SECTION 1: READY ORDERS TAB (SERVE)
   * ========================================== -->
  <!-- เมนูสลับไปหน้าออเดอร์พร้อมเสิร์ฟ -->
  <a href="/counter" class="<%= page === 'ready' ? 'active' : '' %>">
    🛎️ ออเดอร์ที่ต้องเสิร์ฟ
    <% if (counts.cooked > 0) { %>
      <span class="nav-badge">
        <%= counts.cooked %>
      </span>
    <% } %>
  </a>

  <!-- ==========================================
   * SECTION 2: NOTIFICATIONS TAB (CALL CUSTOMER)
   * ========================================== -->
  <!-- เมนูสลับไปหน้าแจ้งเตือนเรียกรับอาหาร -->
  <a href="/counter/notify" class="<%= page === 'notify' ? 'active' : '' %>">
    🔔 แจ้งเตือน
    <% if (counts.ready > 0) { %>
      <span class="nav-badge">
        <%= counts.ready %>
      </span>
    <% } %>
  </a>

</nav>
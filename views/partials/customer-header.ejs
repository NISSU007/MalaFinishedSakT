<!-- ==========================================================================
 * FILE: views/partials/customer_header.ejs
 * DESCRIPTION: แถบส่วนหัวหน้าจอฝั่งลูกค้า (แสดงโลโก้ร้านและหมายเลขโต๊ะอาหาร)
 * ========================================================================== -->

<!-- แถบหัวหน้าลูกค้า (โลโก้ + เลขโต๊ะ) -->
<header class="c-header">
  <!-- ==========================================
   * SECTION 1: BRAND LOGO & MENU HOME LINK
   * ========================================== -->
  <a class="c-logo" href="/table/<%= table.Table_ID %>/menu">
    🍲 หม่าล่า <span>Self Service</span>
  </a>

  <!-- ==========================================
   * SECTION 2: TABLE NUMBER BADGE
   * ========================================== -->
  <div class="c-header-right">
    <!-- ถ้าเป็นกลับบ้านให้แสดงแค่ "กลับบ้าน" แต่ถ้าไม่ใช่ให้เติมคำว่า "โต๊ะ: " นำหน้า -->
    <span class="c-table"><%= table.Table_Number === 'กลับบ้าน' ? 'รับกลับบ้าน' : 'โต๊ะ: ' + table.Table_Number %></span>
  </div>
</header>
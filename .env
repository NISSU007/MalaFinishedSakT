# ============================================================================
# ตัวอย่างไฟล์ตั้งค่าการชำระเงิน
# วิธีใช้: คัดลอกไฟล์นี้เป็น .env  (คำสั่ง:  cp .env.example .env)  แล้วแก้ค่าให้ตรงกับร้าน
# ============================================================================

# ---- พร้อมเพย์ (ใช้ได้ทั้งบัญชีส่วนตัวและร้านค้า) ----
# ใส่เบอร์มือถือ 10 หลัก หรือเลขบัตรประชาชน 13 หลัก ที่ผูกพร้อมเพย์ไว้
# QR ที่สร้างจากเลขนี้จะสแกนได้จริงและโชว์ยอดเงินในทุกแอปธนาคาร เงินเข้าบัญชีนี้
PROMPTPAY_ID=0988588573
MERCHANT_NAME=ร้านหม่าล่า Self Service

# ---- โหมดจำลอง ----
# true  = มีปุ่ม "จำลองว่าชำระแล้ว" ไว้ทดสอบ (ไม่ต้องโอนจริง)
# false = ปิดปุ่มจำลอง สำหรับใช้งานจริง
PAYMENT_DEMO_MODE=true

# เวลาที่ให้ชำระเงินต่อ 1 ออเดอร์ (วินาที)
QR_TIMEOUT_SEC=900

# ============================================================================
# ---- KBank Open API (ไม่บังคับ / ต้องมีบัญชีร้านค้า KBank) ----
# เปิดใช้เมื่อได้ Consumer Key/Secret + Merchant ID จาก KBank Developer Portal
# เมื่อเปิดใช้ ระบบจะสร้าง QR ผ่าน KBank และ "ยืนยันเงินเข้าอัตโนมัติ"
# ============================================================================
KBANK_ENABLED=false
KBANK_BASE_URL=https://openapi-sandbox.kasikornbank.com
KBANK_CONSUMER_KEY=
KBANK_CONSUMER_SECRET=
KBANK_PARTNER_ID=
KBANK_PARTNER_SECRET=
KBANK_MERCHANT_ID=
KBANK_TERMINAL_ID=
# path ไปยังไฟล์ใบรับรอง mTLS (ถ้า KBank กำหนดให้ใช้)
KBANK_CERT_PATH=
KBANK_KEY_PATH=
